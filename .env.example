# Firebase Web (client) config — these values are public identifiers, not
# secrets. Restrict the API key's allowed referrers/APIs in the Firebase
# console instead of hiding it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# When true, the client SDK connects to the local Firebase Emulator Suite
# (Auth/Firestore/Storage) instead of the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Server-side (Admin SDK) credentials. Required only when
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false, i.e. talking to real Firebase.
# Generate via Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Base URL of the deployed app — used for metadataBase (canonical/OG image
# URLs), robots.txt, and sitemap.xml. Set to http://localhost:3000 in local
# development, or https://tuitionserve.com in production.
NEXT_PUBLIC_SITE_URL=https://tuitionserve.com

# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=ts_session

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when
# calling /api/cron/cleanup-rejected — generate any random string
# (e.g. `openssl rand -hex 24`) and set the same value on Vercel.
CRON_SECRET=

# Google Search Console HTML tag verification token (optional — enables automatic
# `<meta name="google-site-verification" ...>` in RootLayout).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456) and slot IDs.
# Setting NEXT_PUBLIC_ADSENSE_CLIENT_ID enables /ads.txt and loads adsbygoogle.js.
# Individual ad banners only render once their numeric slot IDs are also provided.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_VACANCIES_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_VACANCY_DETAIL=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_IN_ARTICLE=
